* text=auto
gradlew text eol=lf
*.bat text eol=crlf
*.pdf binary
*.png binary
*.jar binary
# Native captures and evidence logs are byte-hashed in their manifests.
docs/validation/readiness/*.xml -text -whitespace
docs/validation/touch-readability/*.xml -text -whitespace
docs/validation/extension-compatibility/*.xml -text -whitespace
docs/validation/extension-compatibility/**/*.xml -text -whitespace
docs/validation/extension-compatibility/**/*.log -text -whitespace
docs/validation/calculator-actions/** -text -whitespace
third_party/** linguist-vendored
app/src/main/assets/RaycastRuntime.generated.js linguist-generated

# Preserve original transport evidence bytes, including CRLF captures.
docs/validation/extension-compatibility/fetch/** -text -whitespace

# Preserve offline workflow evidence bytes.
docs/validation/offline-workflows/** -text -whitespace

# Preserve context workflow receipts and native XML bytes.
docs/validation/context-workflows/** -text -whitespace

# Preserve command handoff evidence and native capture bytes.
docs/validation/command-handoff/** -text -whitespace

# Preserve paste-copy evidence and native capture bytes.
docs/validation/paste-copy/** -text -whitespace

# Preserve recorded-test receipts and native capture bytes.
docs/validation/recorded-tests/** -text -whitespace

# Preserve WebView engine evidence bytes, including native XML CRLF.
docs/validation/webview-engine/** -text -whitespace
docs/validation/native-input/** -text -whitespace

# Preserve touch-search receipts and raw native hierarchy CRLF bytes.
docs/validation/touch-search/** -text -whitespace

# Preserve empty-feedback evidence and raw Android hierarchy CRLF.
docs/validation/empty-feedback/** -text -whitespace

# Preserve keyboard visibility receipts and native XML CRLF.
docs/validation/keyboard-toggle/** -text -whitespace
